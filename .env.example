# Every variable cmd/calbridge and docker-compose.yaml read, with the
# defaults they fall back to. Copy to .env for a local run. .env itself is
# never committed.

# Address the HTTP server listens on.
LISTEN_ADDR=:8080

# Address the administrative listener serves liveness, readiness and metrics
# on. Neither route in charts/calbridge ever targets it.
ADMIN_LISTEN_ADDR=:8081

# One of debug, info, warn, error.
LOG_LEVEL=info

# How long the server keeps serving after its readiness check starts
# failing, so a load balancer notices before the listener closes. Must stay
# above the chart's readinessProbe periodSeconds times failureThreshold.
DRAIN_DELAY=5s

# DATABASE_URL, DATABASE_USER and DATABASE_PASSWORD are set by
# docker-compose.yaml's own calbridge service, which reuses APP_DB_PASSWORD
# below under the name cmd/calbridge reads. Set all three here only to run
# cmd/calbridge directly, outside compose.
# DATABASE_URL=postgres://postgres:5432/calbridge?sslmode=disable
# DATABASE_USER=calbridge_app
# DATABASE_PASSWORD=

# The bootstrap superuser docker-compose.yaml's postgres and migrate services
# use to create the database and apply db/migrations. It is deliberately not
# the role the application connects as: row level security is only a
# guarantee while the application role cannot bypass it.
# Generate with: openssl rand -hex 24
POSTGRES_SUPERUSER_PASSWORD=

# The restricted NOSUPERUSER NOBYPASSRLS role cmd/calbridge connects as,
# created by docker/postgres/init-app-role.sh.
# Generate with: openssl rand -hex 24
APP_DB_PASSWORD=

# Encrypts connections.credentials and event_mapping's cached details at
# rest. Exactly 32 bytes once decoded, so 64 hex characters.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
