# syntax=docker/dockerfile:1@sha256:572cebbc2b15e6f84c077742952674889cb63cd5e9b80abdffcbe587b6f19183

# The public landing server's own image, separate from the application's
# own Dockerfile: a correction to the privacy policy's text rebuilds and
# redeploys this image alone, never cmd/calbridge's. Every stage below
# mirrors the application's own Dockerfile line for line, built from
# web-landing/ and cmd/calbridge-landing instead of web/ and
# cmd/calbridge; see that file's own comments for the full reasoning
# behind each pin.
FROM node:26.13.1-bookworm-slim@sha256:5df79989ed685e09f0a98019db4cebfb22fb9df1a53c0161664a011f7ff6b0f1 AS web

WORKDIR /src

RUN npm install -g corepack@0.36.0 && corepack enable && corepack prepare pnpm@12.19.0 --activate

COPY web-landing/package.json web-landing/pnpm-lock.yaml web-landing/pnpm-workspace.yaml web-landing/
RUN cd web-landing && pnpm install --frozen-lockfile

COPY web-landing/ web-landing/
RUN mkdir -p cmd/calbridge-landing && cd web-landing && pnpm run build

FROM golang:1.27.4-bookworm@sha256:ce59b41415e2524ae99926fe1f37ce48ba8c194dcbd2a56a65436cdcefa2bd34 AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

# These three paths are the whole of this binary, and the list is a
# guard as much as a copy: an import of internal/httpapi or
# internal/storage from either landing package fails this build stage
# outright, because the source it would need is not in the context.
# internal/depsync's own landingimports_test.go is the check that
# reports the same mistake as a test failure rather than a compile error
# inside a container build; keep the two lists together.
COPY cmd/calbridge-landing/ cmd/calbridge-landing/
COPY internal/landingapi/ internal/landingapi/
COPY internal/landingconfig/ internal/landingconfig/
COPY --from=web /src/cmd/calbridge-landing/dist/ cmd/calbridge-landing/dist/

RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/calbridge-landing ./cmd/calbridge-landing

# Same base image as the application's own runtime stage, for the same
# reasons: no shell, no package manager, a minimal trust store for the
# admin listener's own metrics scrape (no outbound call of its own
# today, kept anyway for consistency with the application's image).
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab

COPY --from=build /out/calbridge-landing /usr/local/bin/calbridge-landing

# Matches LISTEN_ADDR's default (":8080", internal/landingconfig.Load).
EXPOSE 8080

USER 65532:65532

ENTRYPOINT ["/usr/local/bin/calbridge-landing"]
