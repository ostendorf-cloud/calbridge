# The global pnpm store sits outside this repository, and a sandboxed run
# that has no write access there fails with ERR_PNPM_STORE_DIR_OPEN_OPERATION_LOCK.
# Pointing the store inside web/ keeps every install writing only where this
# repository already expects writes; see .gitignore's own ".pnpm-store/" entry.
store-dir=.pnpm-store
