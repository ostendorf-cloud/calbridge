{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "calbridge",
  "type": "object",
  "required": ["image", "service", "config", "existingSecret", "migrationJob", "landing"],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": { "type": "object" }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": {
      "type": "object",
      "required": ["runAsNonRoot"],
      "properties": {
        "runAsNonRoot": { "const": true },
        "runAsUser": { "type": "integer" },
        "runAsGroup": { "type": "integer" },
        "fsGroup": { "type": "integer" },
        "seccompProfile": { "type": "object" }
      }
    },
    "securityContext": {
      "type": "object",
      "required": ["readOnlyRootFilesystem", "allowPrivilegeEscalation", "capabilities"],
      "properties": {
        "readOnlyRootFilesystem": { "const": true },
        "allowPrivilegeEscalation": { "const": false },
        "capabilities": {
          "type": "object",
          "required": ["drop"],
          "properties": {
            "drop": { "type": "array", "contains": { "const": "ALL" } }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "port", "adminPort"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "adminPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "The administrative container port cmd/calbridge serves liveness, readiness and metrics on through govue's httpserver.RunAdmin. Must match config.adminListenAddr. Exposed on the Service as its own named port; the Ingress and the HTTPRoute still only ever route to service.port, never here."
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": { "type": "array" },
        "tls": { "type": "array" }
      }
    },
    "httproute": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "annotations": { "type": "object" },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "namespace": { "type": "string" },
              "sectionName": { "type": "string" }
            }
          }
        },
        "hostnames": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "resources": { "type": "object" },
    "startupProbe": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "livenessProbe": {
      "type": "object",
      "properties": {
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "readinessProbe": {
      "type": "object",
      "properties": {
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
    "config": {
      "type": "object",
      "required": ["listenAddr", "adminListenAddr", "drainDelay", "databaseUrl", "databaseUser"],
      "properties": {
        "listenAddr": { "type": "string", "minLength": 1 },
        "adminListenAddr": {
          "type": "string",
          "minLength": 1,
          "description": "ADMIN_LISTEN_ADDR. Must match service.adminPort. Liveness, readiness and metrics are served here, never on listenAddr; see service.adminPort's own description."
        },
        "drainDelay": {
          "type": "string",
          "minLength": 1,
          "description": "DRAIN_DELAY, a Go duration such as \"5s\". Must stay above readinessProbe.periodSeconds times readinessProbe.failureThreshold."
        },
        "logLevel": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"]
        },
        "databaseUrl": {
          "type": "string",
          "minLength": 1,
          "description": "DATABASE_URL: the connection URL without credentials. The role config.databaseUser names MUST be NOSUPERUSER and NOBYPASSRLS, or row level security provides no actual protection; see values.yaml's own comment."
        },
        "databaseUser": {
          "type": "string",
          "minLength": 1,
          "description": "DATABASE_USER. MUST be NOSUPERUSER and NOBYPASSRLS; see databaseUrl's own description."
        },
        "trustedProxyCIDRs": {
          "type": "string",
          "description": "TRUSTED_PROXY_CIDRS, a comma separated list of CIDRs (or bare addresses) the rate limiters trust to have appended the real client address to X-Forwarded-For. Empty keeps them keyed on the TCP peer, which behind ingress.enabled or httproute.enabled is the ingress controller or Gateway data plane for every request, not the client."
        },
        "authBaseUrl": {
          "type": "string",
          "description": "AUTH_BASE_URL, the public base URL of this deployment, for example \"https://calbridge.example.com\". Provider redirect URLs are built from it and it must match the redirect URL registered at the provider. Empty by default, which leaves provider sign-in unreachable."
        },
        "publicSiteUrl": {
          "type": "string",
          "description": "PUBLIC_SITE_URL, the public landing page's own base URL, for example \"https://calbridge.example.com\". Rendered into the login screen and the signed-in shell as the link back to the public site. Empty by default, which renders no such link."
        },
        "registrationClosed": {
          "type": "boolean",
          "description": "REGISTRATION_CLOSED. True refuses every new account, by password signup and by first provider sign-in, and leaves existing accounts able to sign in. False by default, which leaves an exposed instance open to anyone who can reach it."
        },
        "auth": {
          "type": "object",
          "properties": {
            "google": {
              "type": "object",
              "properties": {
                "clientId": {
                  "type": "string",
                  "description": "AUTH_GOOGLE_CLIENT_ID. Empty by default; empty means Google sign-in is simply not offered."
                },
                "issuer": {
                  "type": "string",
                  "description": "AUTH_GOOGLE_ISSUER. Empty by default, which makes internal/config use its own documented default Google issuer."
                }
              }
            },
            "microsoft": {
              "type": "object",
              "properties": {
                "clientId": {
                  "type": "string",
                  "description": "AUTH_MICROSOFT_CLIENT_ID. Empty by default; empty means Microsoft sign-in is simply not offered."
                },
                "issuer": {
                  "type": "string",
                  "description": "AUTH_MICROSOFT_ISSUER. Empty by default, which makes internal/config use its own documented default, multi-tenant Microsoft issuer. Set this only for a tenant-specific issuer."
                }
              }
            },
            "apple": {
              "type": "object",
              "properties": {
                "clientId": {
                  "type": "string",
                  "description": "AUTH_APPLE_CLIENT_ID. Empty by default; empty means Apple sign-in is simply not offered."
                },
                "issuer": {
                  "type": "string",
                  "description": "AUTH_APPLE_ISSUER. Empty by default, which makes internal/config use its own documented default Apple issuer."
                }
              }
            }
          }
        }
      }
    },
    "existingSecret": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "databasePasswordKey": { "type": "string", "minLength": 1 },
        "encryptionKeyKey": { "type": "string", "minLength": 1 },
        "migrationDatabasePasswordKey": { "type": "string" },
        "googleClientSecretKey": { "type": "string", "minLength": 1 },
        "microsoftClientSecretKey": { "type": "string", "minLength": 1 },
        "appleClientSecretKey": { "type": "string", "minLength": 1 }
      }
    },
    "migrationJob": {
      "type": "object",
      "required": ["enabled", "databaseUser"],
      "properties": {
        "enabled": { "type": "boolean" },
        "databaseUser": {
          "type": "string",
          "minLength": 1,
          "description": "A separate role, distinct from config.databaseUser, that owns every table db/migrations creates and applies them. Required; no usable default. See README.md's \"Migrations run as a separate role\" section."
        },
        "image": {
          "type": "object",
          "required": ["repository", "tag", "digest"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$",
              "description": "The dbmate image's digest, matching docker-compose.yaml's own pin, for Renovate's pinDigests."
            }
          }
        },
        "annotations": { "type": "object" },
        "resources": { "type": "object" }
      }
    },
    "landing": {
      "type": "object",
      "required": ["image", "service", "config"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "image": {
          "type": "object",
          "required": ["repository"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "imagePullSecrets": {
          "type": "array",
          "items": { "type": "object" }
        },
        "serviceAccount": {
          "type": "object",
          "properties": {
            "create": { "type": "boolean" },
            "annotations": { "type": "object" },
            "name": { "type": "string" }
          }
        },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "podSecurityContext": {
          "type": "object",
          "required": ["runAsNonRoot"],
          "properties": {
            "runAsNonRoot": { "const": true },
            "runAsUser": { "type": "integer" },
            "runAsGroup": { "type": "integer" },
            "fsGroup": { "type": "integer" },
            "seccompProfile": { "type": "object" }
          }
        },
        "securityContext": {
          "type": "object",
          "required": ["readOnlyRootFilesystem", "allowPrivilegeEscalation", "capabilities"],
          "properties": {
            "readOnlyRootFilesystem": { "const": true },
            "allowPrivilegeEscalation": { "const": false },
            "capabilities": {
              "type": "object",
              "required": ["drop"],
              "properties": {
                "drop": { "type": "array", "contains": { "const": "ALL" } }
              }
            }
          }
        },
        "service": {
          "type": "object",
          "required": ["type", "port", "adminPort"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
            },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "adminPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "ingress": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "className": { "type": "string" },
            "annotations": { "type": "object" },
            "hosts": { "type": "array" },
            "tls": { "type": "array" }
          }
        },
        "httproute": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "annotations": { "type": "object" },
            "parentRefs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "namespace": { "type": "string" },
                  "sectionName": { "type": "string" }
                }
              }
            },
            "hostnames": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "resources": { "type": "object" },
        "startupProbe": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "initialDelaySeconds": { "type": "integer", "minimum": 0 },
            "periodSeconds": { "type": "integer", "minimum": 1 },
            "failureThreshold": { "type": "integer", "minimum": 1 }
          }
        },
        "livenessProbe": {
          "type": "object",
          "properties": {
            "initialDelaySeconds": { "type": "integer", "minimum": 0 },
            "periodSeconds": { "type": "integer", "minimum": 1 },
            "failureThreshold": { "type": "integer", "minimum": 1 }
          }
        },
        "readinessProbe": {
          "type": "object",
          "properties": {
            "initialDelaySeconds": { "type": "integer", "minimum": 0 },
            "periodSeconds": { "type": "integer", "minimum": 1 },
            "failureThreshold": { "type": "integer", "minimum": 1 }
          }
        },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
        "config": {
          "type": "object",
          "required": ["listenAddr", "adminListenAddr", "drainDelay", "appUrl", "operator"],
          "properties": {
            "listenAddr": { "type": "string", "minLength": 1 },
            "adminListenAddr": { "type": "string", "minLength": 1 },
            "drainDelay": { "type": "string", "minLength": 1 },
            "logLevel": {
              "type": "string",
              "enum": ["debug", "info", "warn", "error"]
            },
            "appUrl": {
              "type": "string",
              "minLength": 1,
              "description": "APP_URL, the application's own public base URL, for example \"https://app.calbridge.example.com\". internal/landingconfig.Load refuses to start without it; every page's call to action is built from this value rather than a host fixed at image build time."
            },
            "operator": {
              "type": "object",
              "required": ["name", "street", "postalCode", "city", "email"],
              "description": "The real-world operator the imprint, the privacy statement and the terms name, mapped to the OPERATOR_* environment variables. internal/landingconfig.Load refuses to start without the five required fields. An empty optional field renders no variable.",
              "properties": {
                "name": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S" },
                "street": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S" },
                "postalCode": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S" },
                "city": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S" },
                "email": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S" },
                "country": { "type": "string", "maxLength": 300 },
                "phone": { "type": "string", "maxLength": 300 },
                "representative": { "type": "string", "maxLength": 300 },
                "register": { "type": "string", "maxLength": 300 },
                "vatId": { "type": "string", "maxLength": 300 },
                "contentResponsible": { "type": "string", "maxLength": 300 },
                "dataProtection": { "type": "string", "maxLength": 300 }
              }
            }
          }
        }
      }
    }
  }
}
